suite "a3s-code-tui-composer-help" {
    version = 1

    scenario "open-help-panel" {
        name = "Slash /help opens the grouped reference panel"
        surface = "tui"
        timeout_ms = 60000

        wait "first-frame" {
            text = "Type a message"
        }

        terminal_paste "slash-help" {
            text = "/help"
        }

        press "submit" {
            key = "Enter"
        }

        wait "help-title" {
            text = "A3S Code"
        }

        wait "help-ctrl-j" {
            regex = "Ctrl\\+J"
        }

        press "page-toward-sandbox" {
            key = "PageDown"
        }

        press "page-toward-sandbox-2" {
            key = "PageDown"
        }

        press "page-toward-sandbox-3" {
            key = "PageDown"
        }

        press "page-toward-sandbox-4" {
            key = "PageDown"
        }

        press "page-toward-sandbox-5" {
            key = "PageDown"
        }

        wait "help-sandbox" {
            text = "/sandbox"
        }

        expect "help-sandbox-visible" {
            text = "/sandbox"
        }

        terminal_recording "help" {
            path = "evidence/help.vt"
        }
    }
}
