suite "queue-serial" {
    version = 1

    scenario "mid-turn-queue-serializes" {
        name = "a command queued mid-turn runs serialized after the active turn, exactly once (live model)"
        surface = "tui"
        timeout_ms = 420000

        wait "boot" {
            regex = "a3s-code v[0-9]|A3S"
        }

        # The model footer renders only after initialize + model-state sync:
        # the reliable session-ready signal (model name from the ACL catalog).
        # The model footer shows the pager default (Grok 4.5) until the
        # backend's modelState syncs post-new_session; the synced model name
        # is the reliable session-live signal.
        # Ready = the model footer rendered post-initialize. The footer model
        # name varies (ACL model, cc-switch import, or pager default), so
        # match the stable suffix: effort + mode.
        wait "composer-ready" {
            regex = "high.. always-approve"
        }

        terminal_paste "long-turn-text" {
            text = "Count from 1 to 12, one number per line, then reply with exactly COUNT-DONE-5521. Do not use any tools."
        }

        press "long-turn-enter" {
            key = "Enter"
        }

        wait "count-underway" {
            regex = "\\b[3-9]\\b"
        }

        terminal_paste "queued-status-text" {
            text = "/goal status"
        }

        press "queued-status-enter" {
            key = "Enter"
        }

        wait "count-finished" {
            text = "COUNT-DONE-5521"
        }

        wait "queued-command-reply" {
            regex = "Durable goal (active|paused)?:|No durable goal is set\\."
        }

        terminal_recording "queue" {
            path = "evidence/queue-serial.vt"
        }
    }
}
