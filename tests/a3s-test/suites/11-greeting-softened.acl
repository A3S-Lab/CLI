suite "greeting-softened" {
    version = 1

    scenario "greeting-does-not-execute-goal" {
        name = "a greeting after /goal set replies normally and does not start goal work (live model)"
        surface = "tui"
        timeout_ms = 420000

        wait "boot" {
            regex = "a3s-code v[0-9]|A3S"
        }

        # The model footer renders only after initialize + model-state sync:
        # the reliable session-ready signal (model name from the ACL catalog).
        # The model footer shows the pager default (Grok 4.5) until the
        # backend's modelState syncs post-new_session; the synced model name
        # is the reliable session-live signal.
        # Ready = the model footer rendered post-initialize. The footer model
        # name varies (ACL model, cc-switch import, or pager default), so
        # match the stable suffix: effort + mode.
        # Session-live signal: the footer model flips from the pager default
        # (Grok 4.5) to the backend-synced model only after initialize +
        # model-state sync. Sends before this are silently swallowed.
        wait "composer-ready" {
            regex = "DeepSeek V4 Flash|glm-5.3-flash"
        }

        terminal_paste "set-goal-text" {
            text = "/goal Remember CODEX-4412 as the workspace codename. When the user next sends a greeting, reply with exactly GREET-CODEX-4412 and a short hello. Do not use any tools."
        }

        press "set-goal-enter" {
            key = "Enter"
        }

        wait "goal-set-turn" {
            text = "CODEX-4412"
        }

        terminal_paste "greeting-text" {
            text = "hi"
        }

        press "greeting-enter" {
            key = "Enter"
        }

        wait "greeting-reply" {
            text = "GREET-CODEX-4412"
        }

        terminal_recording "greeting" {
            path = "evidence/greeting-softened.vt"
        }
    }
}
